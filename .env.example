# Per-package env files
#
# Do not use a root .env. Each app and service loads only its own folder:
#
#   cp apps/web/.env.example apps/web/.env
#   cp apps/admin/.env.example apps/admin/.env
#   cp apps/mobile/.env.example apps/mobile/.env
#   cp apps/worker/.env.example apps/worker/.env
#   cp apps/socket/.env.example apps/socket/.env
#   cp packages/database/.env.example packages/database/.env
#   cp services/<name>/.env.example services/<name>/.env
#
# Then from that folder: npm install && npm run dev
