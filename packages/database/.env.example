# Local to packages/database only (Prisma CLI).
NODE_ENV=development

# Copy Session pooler host from Supabase → Connect. Direct db.* host is IPv6-only.
SUPABASE_USE_POOLER=true
SUPABASE_POOLER_HOST=
SUPABASE_POOLER_PORT=5432
SUPABASE_DB_HOST=db.aghzvdmlczybfaffmwbb.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=

DATABASE_URL=postgresql://postgres.aghzvdmlczybfaffmwbb:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=public
DIRECT_URL=postgresql://postgres.aghzvdmlczybfaffmwbb:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
