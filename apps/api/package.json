{
  "name": "@dream-drive/api",
  "version": "0.1.0",
  "private": true,
  "description": "Dream-Drive HTTP API — all domain modules in one NestJS process",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main",
    "lint": "echo \"lint api\"",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --testPathPatterns unit",
    "test:e2e": "jest --testPathPatterns e2e"
  },
  "dependencies": {
    "@dream-drive/database": "file:../../packages/database",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
